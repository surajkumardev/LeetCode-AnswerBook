class Solution {
public:
    int compress(vector<char>& chars) {
        int n=chars.size();
        int index=0;  //you can not se the count 0 here as you have reinitalize it every time after the loop 
        for(int i=0;i<n;i++){
            char ch=chars[i]; // will store the a 
            int count=0;
            while(i<n && chars[i]==ch){
                count++;
                i++;
            }
            if(count==1){
                chars[index++]=ch;
            }
            else{
                chars[index++]=ch;
                string str=to_string(count); //will conver the integer to the string 
                for(char dig: str){
                    chars[index++]=dig;
                }
            }
            i--;
        }
        
        chars.resize(index);
        return index;
    }
};


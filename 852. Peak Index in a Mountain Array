class Solution {
public:
    int peakIndexInMountainArray(vector<int>& arr) {
        // int n=arr.size(); 
        int st=1, end=arr.size()-2; //-> will remove the edge cases that it handles
        while(st<=end){
            int mid=st+(end-st)/2; //use this only
            if(arr[mid-1]<arr[mid] && arr[mid]>arr[mid+1])
                        return mid;
                else if(arr[mid-1]<arr[mid]){ //right
                            st=mid+1;
                 }
                else{ //left sub array
                            end=mid-1;
            }
        
        }
        return -1;
    }
};

